<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fee Management System</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Arial,Helvetica,sans-serif}body{background:#f4f7fb;color:#1f2937}.hidden{display:none!important}header{background:#0f766e;color:#fff;padding:16px 22px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.login-box{max-width:420px;margin:70px auto;background:white;padding:24px;border-radius:14px;box-shadow:0 8px 25px rgba(0,0,0,.08)}.login-box h2{margin-bottom:16px;color:#0f766e;text-align:center}input,select,textarea,button{width:100%;padding:10px;border:1px solid #d1d5db;border-radius:8px;font-size:14px}textarea{min-height:70px}button{border:none;background:#0f766e;color:white;cursor:pointer;font-weight:bold}button:hover{background:#115e59}.btn-secondary{background:#475569}.btn-danger{background:#dc2626}.btn-small{padding:7px 10px;font-size:12px;width:auto;margin:2px}.app{display:none}.layout{display:flex;min-height:calc(100vh - 64px)}nav{width:245px;background:#111827;color:white;padding:14px}nav button{background:transparent;border:0;color:white;text-align:left;padding:12px;border-radius:8px;margin-bottom:5px}nav button:hover,nav button.active{background:#0f766e}main{flex:1;padding:20px;overflow:auto}.section{display:none}.section.active{display:block}.card{background:white;border-radius:14px;padding:18px;box-shadow:0 4px 14px rgba(0,0,0,.06);margin-bottom:14px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:14px}.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;margin-top:12px}label{font-size:13px;font-weight:bold;color:#374151;margin-bottom:5px;display:block}table{width:100%;border-collapse:collapse;margin-top:12px;background:white;border-radius:12px;overflow:hidden}th,td{border-bottom:1px solid #e5e7eb;padding:10px;text-align:left;font-size:13px;vertical-align:top}th{background:#e0f2f1;color:#064e3b}.top-actions{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}.top-actions button{width:auto}.note{background:#fff7ed;border-left:4px solid #f97316;padding:10px;margin-bottom:12px;border-radius:8px;color:#7c2d12}.loading{position:fixed;inset:0;background:rgba(255,255,255,.75);display:none;align-items:center;justify-content:center;font-size:20px;font-weight:bold;color:#0f766e;z-index:999}.value{font-size:26px;font-weight:bold;color:#0f766e}@media(max-width:800px){.layout{flex-direction:column}nav{width:100%;display:grid;grid-template-columns:repeat(2,1fr);gap:6px}main{padding:12px}}
</style>
</head>
<body>
<div id="loading" class="loading">Loading...</div>
<div id="loginPage" class="login-box">
  <h2>Fee Management Login</h2>
  <div style="display:grid;gap:12px">
    <div><label>Username</label><input id="loginUser" value="admin"></div>
    <div><label>Password</label><input id="loginPass" value="admin123" type="password"></div>
    <button onclick="login()">Login</button>
    <p style="font-size:13px;color:#64748b;text-align:center">Default: admin/admin123, accountant/1234, entryuser/1234</p>
  </div>
</div>
<div id="app" class="app">
<header><h1>Fee Management System</h1><div><span id="userInfo"></span> <button class="btn-secondary btn-small" onclick="location.href='index.html'">Main Portal</button> <button class="btn-secondary btn-small" onclick="logout()">Logout</button></div></header>
<div class="layout"><nav>
<button class="active" onclick="showSection('dashboard',this)">Dashboard</button>
<button onclick="showSection('students',this)">Students</button>
<button onclick="showSection('importStudents',this)">Import Students</button>
<button class="admin-only" onclick="showSection('masters',this)">Masters</button>
</nav><main>
<section id="dashboard" class="section active">
 <div class="grid"><div class="card"><h3>Total Students</h3><div class="value" id="totalStudents">0</div></div><div class="card"><h3>Hostel Students</h3><div class="value" id="hostelStudents">0</div></div><div class="card"><h3>Day Scholars</h3><div class="value" id="dayStudents">0</div></div></div>
 <div class="card"><h2>Branch Summary</h2><table id="branchSummaryTable"></table></div>
</section>
<section id="students" class="section">
 <div class="card"><h2>Student Master</h2><div class="form-grid">
  <div><label>Admission No</label><input id="stAdmissionNo"></div><div><label>Student Name</label><input id="stName"></div><div><label>Branch</label><select id="stBranch" onchange="loadStudentCourses()"></select></div><div><label>Course</label><select id="stCourse" onchange="fillDuration()"></select></div><div><label>Course Duration</label><input id="stDuration" type="number"></div><div><label>Current Year</label><select id="stCurrentYear"><option>1</option><option>2</option><option>3</option></select></div><div><label>Admission Academic Year</label><input id="stAcademicYear" placeholder="2026-27"></div><div><label>Hostel</label><select id="stHostel"><option>No</option><option>Yes</option></select></div><div><label>Mobile</label><input id="stMobile"></div><div><label>Active</label><select id="stActive"><option>YES</option><option>NO</option></select></div><div style="grid-column:1/-1"><label>Remarks</label><textarea id="stRemarks"></textarea></div>
 </div><div class="top-actions"><button onclick="saveStudent()">Save Student</button><button class="btn-secondary" onclick="clearStudentForm()">Clear</button></div></div>
 <div class="card"><h2>Student List</h2><div class="form-grid"><input id="searchStudent" placeholder="Search admission/name/mobile" oninput="renderStudents()"><select id="filterBranch" onchange="renderStudents()"></select><select id="filterHostel" onchange="renderStudents()"><option value="">All Hostel</option><option>Yes</option><option>No</option></select></div><table id="studentsTable"></table></div>
</section>
<section id="importStudents" class="section">
 <div class="card"><h2>Bulk Import Students</h2><div class="note">Paste CSV rows with columns: AdmissionNo,StudentName,Branch,Course,CourseDuration,CurrentYear,AcademicYear,Hostel,Mobile,Active,Remarks</div><textarea id="importText" style="min-height:220px" placeholder="260001,Ravi,Degree,B.Sc,3,1,2026-27,Yes,9876543210,YES,"></textarea><div class="top-actions"><button onclick="importStudentsCSV()">Import Students</button></div><div id="importResult"></div></div>
</section>
<section id="masters" class="section admin-only">
 <div class="grid"><div class="card"><h2>Add Branch</h2><input id="newBranch" placeholder="Branch"><button onclick="addBranch()">Add Branch</button></div><div class="card"><h2>Add Course</h2><select id="courseBranch"></select><input id="newCourse" placeholder="Course"><input id="newCourseDuration" type="number" placeholder="Duration Years"><button onclick="addCourse()">Add Course</button></div></div>
 <div class="card"><h2>Courses</h2><table id="coursesTable"></table></div>
</section>
</main></div></div>
<script>
const API_URL='https://script.google.com/macros/s/AKfycbwrNkDWt-XpCFxAoNGzAmykTEq-PyrcuZpoYSp2WRDL1bh9kRj7575IeFbLSRnf564k/exec';
let token=localStorage.getItem('FEE_TOKEN')||'';let currentUser=JSON.parse(localStorage.getItem('FEE_USER')||'null');let db={students:[],branches:[],courses:[],serverDate:''};
function showLoad(v){loading.style.display=v?'flex':'none'}
async function api(action,payload={}){showLoad(true);try{const r=await fetch(API_URL,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify({action,payload,token})});const j=await r.json();if(!j.success)throw new Error(j.message||'Error');return j;}finally{showLoad(false)}}
function isAdmin(){return currentUser?.role==='Admin'}
async function login(){try{const j=await api('login',{username:loginUser.value.trim(),password:loginPass.value.trim()});token=j.token;currentUser=j.user;localStorage.setItem('FEE_TOKEN',token);localStorage.setItem('FEE_USER',JSON.stringify(currentUser));loginPage.style.display='none';app.style.display='block';userInfo.textContent=currentUser.username+' ('+currentUser.role+')';await refresh();applyRole();}catch(e){alert(e.message)}}
function logout(){token='';currentUser=null;localStorage.removeItem('FEE_TOKEN');localStorage.removeItem('FEE_USER');app.style.display='none';loginPage.style.display='block'}
async function refresh(){const j=await api('getInit');db=j.data;renderAll()}
function applyRole(){document.querySelectorAll('.admin-only').forEach(e=>e.classList.toggle('hidden',!isAdmin()))}
async function showSection(id,btn){document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(token){try{await refresh()}catch(e){console.log(e.message)}}renderAll()}
function opt(sel,arr,all=false){sel.innerHTML=(all?'<option value="">All</option>':'')+arr.map(x=>`<option>${x}</option>`).join('')}
function renderAll(){opt(stBranch,db.branches);opt(filterBranch,db.branches,true);opt(courseBranch,db.branches);loadStudentCourses();renderDashboard();renderStudents();renderCourses()}
function loadStudentCourses(){const b=stBranch.value;const arr=db.courses.filter(c=>c.Branch===b).map(c=>c.Course);opt(stCourse,arr);fillDuration()}
function fillDuration(){const c=db.courses.find(x=>x.Branch===stBranch.value&&x.Course===stCourse.value);if(c)stDuration.value=c.DurationYears||''}
function renderDashboard(){const s=db.students;totalStudents.textContent=s.length;hostelStudents.textContent=s.filter(x=>String(x.Hostel).toLowerCase()==='yes').length;dayStudents.textContent=s.filter(x=>String(x.Hostel).toLowerCase()!=='yes').length;let map={};s.forEach(x=>{const b=x.Branch||'No Branch';map[b]=(map[b]||0)+1});let rows='<tr><th>Branch</th><th>Students</th></tr>';Object.keys(map).sort().forEach(b=>rows+=`<tr><td>${b}</td><td>${map[b]}</td></tr>`);branchSummaryTable.innerHTML=rows}
function renderStudents(){const q=(searchStudent.value||'').toLowerCase(), br=filterBranch.value, hostel=filterHostel.value;let list=db.students.filter(s=>(!q||String(s.AdmissionNo).toLowerCase().includes(q)||String(s.StudentName).toLowerCase().includes(q)||String(s.Mobile).toLowerCase().includes(q))&&(!br||s.Branch===br)&&(!hostel||s.Hostel===hostel));let rows='<tr><th>Action</th><th>Admission No</th><th>Name</th><th>Branch</th><th>Course</th><th>Duration</th><th>Current Year</th><th>Academic Year</th><th>Hostel</th><th>Mobile</th><th>Active</th></tr>';list.slice().reverse().forEach(s=>{rows+=`<tr><td><button class="btn-small" onclick='editStudent(${JSON.stringify(s).replaceAll("'","&#39;")})'>Edit</button>${isAdmin()?`<button class="btn-danger btn-small" onclick="deleteStudent('${s.AdmissionNo}')">Delete</button>`:''}</td><td>${s.AdmissionNo||''}</td><td>${s.StudentName||''}</td><td>${s.Branch||''}</td><td>${s.Course||''}</td><td>${s.CourseDuration||''}</td><td>${s.CurrentYear||''}</td><td>${s.AcademicYear||''}</td><td>${s.Hostel||''}</td><td>${s.Mobile||''}</td><td>${s.Active||''}</td></tr>`});studentsTable.innerHTML=rows}
function editStudent(s){stAdmissionNo.value=s.AdmissionNo||'';stName.value=s.StudentName||'';stBranch.value=s.Branch||'';loadStudentCourses();stCourse.value=s.Course||'';fillDuration();stDuration.value=s.CourseDuration||'';stCurrentYear.value=s.CurrentYear||'1';stAcademicYear.value=s.AcademicYear||'';stHostel.value=s.Hostel||'No';stMobile.value=s.Mobile||'';stActive.value=s.Active||'YES';stRemarks.value=s.Remarks||'';showSection('students',document.querySelector("button[onclick*='students']"))}
function clearStudentForm(){['stAdmissionNo','stName','stMobile','stAcademicYear','stRemarks'].forEach(id=>document.getElementById(id).value='');stHostel.value='No';stActive.value='YES';stCurrentYear.value='1';fillDuration()}
async function saveStudent(){try{const p={AdmissionNo:stAdmissionNo.value,StudentName:stName.value,Branch:stBranch.value,Course:stCourse.value,CourseDuration:stDuration.value,CurrentYear:stCurrentYear.value,AcademicYear:stAcademicYear.value,Hostel:stHostel.value,Mobile:stMobile.value,Active:stActive.value,Remarks:stRemarks.value};const exists=db.students.some(s=>String(s.AdmissionNo)===String(p.AdmissionNo));await api(exists?'updateStudent':'addStudent',p);await refresh();clearStudentForm();alert('Student saved')}catch(e){alert(e.message)}}
async function deleteStudent(adm){if(!confirm('Delete student '+adm+'?'))return;try{await api('deleteStudent',{admissionNo:adm});await refresh()}catch(e){alert(e.message)}}
function parseCSVLine(line){const out=[];let cur='',q=false;for(let i=0;i<line.length;i++){const ch=line[i];if(ch==='"'){q=!q}else if(ch===','&&!q){out.push(cur.trim());cur=''}else cur+=ch}out.push(cur.trim());return out}
async function importStudentsCSV(){try{const lines=importText.value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);const students=lines.map(l=>{const a=parseCSVLine(l);return {AdmissionNo:a[0],StudentName:a[1],Branch:a[2],Course:a[3],CourseDuration:a[4],CurrentYear:a[5],AcademicYear:a[6],Hostel:a[7],Mobile:a[8],Active:a[9]||'YES',Remarks:a[10]||''}});const j=await api('bulkImportStudents',{students});await refresh();importResult.innerHTML='<div class="note">'+j.message+'</div>'}catch(e){alert(e.message)}}
async function addBranch(){try{await api('addBranch',{branch:newBranch.value.trim()});newBranch.value='';await refresh()}catch(e){alert(e.message)}}
async function addCourse(){try{await api('addCourse',{branch:courseBranch.value,course:newCourse.value.trim(),duration:newCourseDuration.value});newCourse.value='';newCourseDuration.value='';await refresh()}catch(e){alert(e.message)}}
function renderCourses(){let rows='<tr><th>Branch</th><th>Course</th><th>Duration</th><th>Active</th></tr>';db.courses.forEach(c=>rows+=`<tr><td>${c.Branch}</td><td>${c.Course}</td><td>${c.DurationYears}</td><td>${c.Active}</td></tr>`);coursesTable.innerHTML=rows}
</script></body></html>
